pkgver() {
  cd "mpd"
  git describe --long --tags | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
#   git describe --long --tags --always | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "mpd"
  sed -e '/\[Service\]/a User=mpd' \
      -i "systemd/system/mpd.service.in"
  cd "$srcdir/$_pkgname"
  msg "Patch 1 ALSA hardware mixer ReplayGain fix"
     patch -Np1 -i "${srcdir}/0001-mixer-Mixer-keep-the-user-volume-separate-from-the-R.patch"  
  msg "Patch 2 pipewire sink mixer support"
     patch -Np1 -i "${srcdir}/0002-mixer-pipewire-add-sink-volume-mixer.patch"
  msg "Patch 3 pipewire sink mixer ReplayGain support"
     patch -Np1 -i "${srcdir}/0003-mixer-pipewire-implement-ScaleVolume-for-the-sink-mi.patch"
}

build() {
  cd "mpd"

  case "$CARCH" in
    arm64)
      export DISTCC_HOSTS="192.168.2.77:3636/8,lzo"
      ;;
    armhf)
      export DISTCC_HOSTS="192.168.2.77:3634/8,lzo"
      ;;
  esac
#  export DISTCC_HOSTS=" "
# Write native file for meson
  cat > distcc-native.ini << 'EOF'
[binaries]
c = ['distcc', 'gcc']
cpp = ['distcc', 'g++']
EOF

  meson setup --prefix /usr \
        --native-file distcc-native.ini \
        --libexecdir lib \
        --sbindir bin \
        --buildtype plain \
        --auto-features enabled \
        --wrap-mode nodownload \
        -D systemd=enabled \
        -D alsa=enabled \
        -D io_uring=enabled \
        -D shine=disabled \
        -D shout=enabled \
        -D pulse=disabled \
        -D vorbis=enabled \
        -D vorbisenc=enabled \
        -D tremor=disabled \
        -D bzip2=enabled \
	-D iso9660=enabled \
	-D zlib=enabled \
	-D zzip=enabled \
        -D neighbor=true \
	-D upnp=pupnp \
	-D zeroconf=avahi \
        -D ipv6=enabled \
	-D tcp=true \
	-D local_socket=true \
        -D nfs=enabled \
	-D smbclient=enabled \
	-D webdav=enabled \
        -D faad=enabled \
	-D adplug=enabled \
	-D audiofile=disabled \
	-D ffmpeg=enabled \
	-D flac=enabled \
	-D fluidsynth=enabled \
	-D gme=enabled \
	-D mad=enabled \
	-D mikmod=enabled \
	-D modplug=enabled \
	-D mpcdec=enabled \
	-D mpg123=enabled \
	-D openmpt=enabled \
	-D opus=enabled \
	-D sidplay=enabled \
	-D sndfile=enabled \
	-D wavpack=enabled \
	-D wildmidi=enabled \
        -D cue=true \
	-D database=true \
	-D expat=enabled \
	-D icu=enabled \
	-D libmpdclient=enabled \
	-D nlohmann_json=enabled \
	-D inotify=true \
	-D soxr=enabled \
	-D libsamplerate=enabled \
	-D sqlite=enabled \
	-D syslog=enabled \
	-D pcre=enabled \
        -D id3tag=enabled \
	-D chromaprint=enabled \
        -D fifo=true \
	-D sndio=enabled \
	-D recorder=true \
	-D httpd=true \
	-D jack=disabled \
	-D ao=enabled \
	-D oss=enabled \
	-D openal=enabled \
	-D pipe=true \
	-D pipewire=enabled \
	-D snapcast=true \
        -D lame=enabled \
	-D twolame=disabled \
	-D wave_encoder=true \
        -D cdio_paranoia=enabled \
	-D curl=enabled \
	-D qobuz=disabled \
	-D mms=enabled \
        -D documentation=enabled \
        -D vgmstream=disabled \
        -D psgplay=disabled \
        build

  ninja -C build
}

# There aren't tests
#check() {
#  cd "mpd"
#  ninja -C build test
#}

package() {
  cd "mpd"
  DESTDIR="${pkgdir}" ninja -C build install
  install -vDm 644 "doc/mpdconf.example" \
    -t "${pkgdir}/usr/share/doc/mpd/"
  install -vDm 644 "doc/mpd.conf.5.rst" -t "${pkgdir}/usr/share/man/man5/"
  install -vDm 644 "doc/mpd.1.rst" -t "${pkgdir}/usr/share/man/man1/"
  install -vDm 644 "../mpd.conf" -t "${pkgdir}/etc/"
  install -vDm 644 "../mpd.sysusers" "${pkgdir}/usr/lib/sysusers.d/mpd.conf"
  install -vDm 644 "../mpd.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/mpd.conf"
  install -vDm 644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
