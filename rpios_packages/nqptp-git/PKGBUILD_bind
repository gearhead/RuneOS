pkgname=nqptp-git
pkgver=1.2.6.r0.gc17af00
pkgrel=2
pkgdesc="A daemon that monitors timing data from PTP clocks"
arch=('arm64' 'armhf' 'amd64')
url="http://github.com/mikebrady/nqptp#readme"
license=('GPL2')
provides=(nqptp)
conflicts=(nqptp)
replaces=(nqptp)
backup=()
options=()
install=nqptp.install
source=("git+http://github.com/mikebrady/nqptp.git"
        nqptp.sysusers
        nqptp.service
        remove-useradd.patch)
noextract=()
md5sums=('SKIP'
         '82b76c105ed8cfdfc6e5082e40b0c115'
         '1cae4aa5cb3e1eb08759c36770ac13b0'
         '941e0ee6389ea55aba20d5da50a35875')

_gitname="nqptp"

pkgver() {
    cd "$srcdir/$_gitname"
    git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

#prepare() {
#  cd nqptp
#  patch -p1 < ../remove-useradd.patch
#}

build() {
  cd "$srcdir/$_gitname"
  autoreconf -fi
  ./configure --prefix=/usr --with-systemd-startup
  make -j4
}

package() {
  cd "$srcdir/$_gitname"
  make -j4 DESTDIR="$pkgdir/" install
  install -D -m644 "$srcdir"/nqptp.sysusers "$pkgdir"/usr/lib/sysusers.d/nqptp.conf
  install -D -m644 "$srcdir"/nqptp.service "$pkgdir"/usr/lib/systemd/system/nqptp.service
}
